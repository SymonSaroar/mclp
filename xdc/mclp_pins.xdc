# ADC card on ZC702 FMC1 (J3), bank 34. VADJ is reprogrammed to 3.3 V (README, Set VADJ to 3.3 V).
set_property -dict {PACKAGE_PIN K19 IOSTANDARD LVCMOS33} [get_ports adc_sclk]
set_property -dict {PACKAGE_PIN K20 IOSTANDARD LVCMOS33} [get_ports adc_din]
set_property -dict {PACKAGE_PIN N19 IOSTANDARD LVCMOS33} [get_ports adc_cs_n]
set_property -dict {PACKAGE_PIN N20 IOSTANDARD LVCMOS33} [get_ports adc_sync_n]
set_property -dict {PACKAGE_PIN L21 IOSTANDARD LVCMOS33} [get_ports {adc_dout[0]}]
set_property -dict {PACKAGE_PIN L22 IOSTANDARD LVCMOS33} [get_ports {adc_dout[1]}]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD LVCMOS33} [get_ports {adc_dout[2]}]
set_property -dict {PACKAGE_PIN K21 IOSTANDARD LVCMOS33} [get_ports {adc_dout[3]}]
set_property -dict {PACKAGE_PIN M21 IOSTANDARD LVCMOS33} [get_ports {adc_dout[4]}]
set_property -dict {PACKAGE_PIN M22 IOSTANDARD LVCMOS33} [get_ports {adc_dout[5]}]
set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33} [get_ports {adc_dout[6]}]
set_property -dict {PACKAGE_PIN N18 IOSTANDARD LVCMOS33} [get_ports {adc_dout[7]}]
