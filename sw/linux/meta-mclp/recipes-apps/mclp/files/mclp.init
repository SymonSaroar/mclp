#!/bin/sh
### BEGIN INIT INFO
# Provides:          mclp
# Required-Start:    $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: UIO access to the MCLP PL, calibration, ADC start-up and the REST/MQTT service
### END INIT INFO

PID=/run/mclpd.pid
LOG=/var/log/mclpd.log

case "$1" in
start)
	# generic-uio nodes (mclp.dtsi): the register block and the AXI DMA with the capture ring.
	# /etc/modprobe.d/mclp-uio.conf sets of_id; a module loaded earlier without it is reloaded.
	modprobe uio_pdrv_genirq
	if [ ! -e /sys/class/uio/uio0 ]; then
		modprobe -r uio_pdrv_genirq
		modprobe uio_pdrv_genirq of_id=generic-uio
	fi
	# check the PL, load /etc/mclp/mclp.cal (or defaults), apply it, run the AD7190 init list.
	# mclpd starts even if this fails, so the fault can be read over the network; on a wrong
	# bitstream mclpd stops by itself (ID check, logged in /var/log/mclpd.log).
	mclp init || echo "mclp: start-up reported a failure; check mclp status and mclp faults"
	# mclpd, first start: a self-signed HTTPS certificate (P-256); replace it with your own. 100 years,
	# counted from the clock at first boot, which may be unset (1970): a shorter validity would already be expired.
	if [ ! -s /etc/mclp/server.key ] || [ ! -s /etc/mclp/server.crt ]; then
		mkdir -p /etc/mclp
		openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 36500 \
			-subj "/CN=$(hostname)" -keyout /etc/mclp/server.key -out /etc/mclp/server.crt 2>>$LOG
		chmod 600 /etc/mclp/server.key
	fi
	[ -s /etc/mclp/users ] || echo "mclpd: no accounts in /etc/mclp/users; REST answers 401" >>$LOG
	start-stop-daemon -S -b -m -p $PID -x /bin/sh -- -c "exec /usr/bin/mclpd >>$LOG 2>&1"
	;;
stop)
	start-stop-daemon -K -p $PID -s TERM
	rm -f $PID
	;;
restart)
	$0 stop
	sleep 1
	$0 start
	;;
*)
	echo "usage: $0 start|stop|restart"
	exit 1
	;;
esac
exit 0
