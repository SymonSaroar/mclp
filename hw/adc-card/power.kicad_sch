		)
		(uuid "c5e68f96-075c-5020-8c3c-7036b62f5597")
	)
	(text "One LDO for AVDD and the excitation: the reference comes from the excitation through the sense lines,\nso it can never sit above AVDD (AD7190: reference 1 V to AVDD). Load 8 x 14.3 mA (350 R cells) + 8 x 6.75 mA\n= 168 mA of 200 mA. NT50 joins the two nets at C57: route EXC_5V and AVDD as separate branches from there.\nSENSE tied to VOUT here; route it as a separate trace to the load side of C57."
		(exclude_from_sim no)
		(at 60 164 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "68185189-23d1-5d4f-a35d-0e220ecac032")
	)
