	)
	(text "LA00..LA05 carry the ADC bus (bank 34, VADJ = 3.3 V). PRSNT_M2C_L to GND marks the card present;\nTDI-TDO through R1 keeps the carrier's JTAG chain closed. 12P0V feeds the buck, VADJ the digital side\n(DVDD), 3P3VAUX the FRU EEPROM."
		(exclude_from_sim no)
		(at 30 226 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8616acf9-c20d-5cdd-937a-2dc676992d62")
	)
